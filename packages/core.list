plasma-pa
bluedevil
powerdevil
kscreen
kde-gtk-config
breeze-gtk-theme
xdg-desktop-portal-kde

# Utilities (minimal, curated)
plasma-systemmonitor
plasma-firewall
dolphin
konsole
kate
ark
spectacle
gwenview
okular

# Power management
power-profiles-daemon

# zram
systemd-zram-generator

# Fonts
fonts-noto-core
fonts-noto-color-emoji