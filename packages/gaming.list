# Sopardus gaming package list (--gaming flag)
# Requires: non-free-firmware, contrib for some packages

# Gaming tools
gamemode
mangohud
gamescope
libgamemode0
libgamemodeauto0

# 32-bit support for Steam/Proton
libc6:i386
libstdc++6:i386
libvulkan1:i386
libdrm2:i386
libx11-6:i386
libxcb1:i386
libxext6:i386
libgl1:i386
libglx0:i386
libegl1:i386

# Vulkan tools
vulkan-tools
vulkan-validationlayers
mesa-vulkan-drivers
mesa-vulkan-drivers:i386

# Steam (Flatpak preferred, but deps here)
steam-devices